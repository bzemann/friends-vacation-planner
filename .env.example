# Base path for the static export. Empty locally, "/friends-vacation-planner"
# on GitHub Pages.
NEXT_PUBLIC_BASE_PATH=

# Public Supabase values (set up in roadmap task 3). These are safe to expose
# in the browser; access is controlled by Row Level Security, not secrecy.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (starts with sb_publishable_...). Public, safe to
# expose in the browser; access is controlled by Row Level Security, not by
# keeping this key secret.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The Anthropic API key never goes in this file, in .env, or in any
# committed file. See the API key policy in CLAUDE.md: it lives only as a
# Supabase function secret (prod) or in the gitignored
# supabase/functions/.env (dev).
